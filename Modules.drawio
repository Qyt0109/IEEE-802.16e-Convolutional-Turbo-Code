        <mxCell id="rryB_cirmL5fwkYxXL1e-37" value="&lt;div style=&quot;font-size: 32px;&quot;&gt;&lt;span style=&quot;background-color: initial; font-size: 32px;&quot;&gt;o_RFFD = 1;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 32px;&quot;&gt;&lt;span style=&quot;background-color: initial; font-size: 32px;&quot;&gt;o_we = 0;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 32px;&quot;&gt;&lt;span style=&quot;background-color: initial; font-size: 32px;&quot;&gt;if (i_FD_IN) begin&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 32px;&quot;&gt;&lt;span style=&quot;background-color: initial; font-size: 32px;&quot;&gt;&amp;nbsp; o_we = 1;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 32px;&quot;&gt;&lt;span style=&quot;background-color: initial; font-size: 32px;&quot;&gt;&amp;nbsp; next_waddr = (waddr + 1);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 32px;&quot;&gt;&lt;span style=&quot;background-color: initial; font-size: 32px;&quot;&gt;&amp;nbsp; next_blk_size = i_BLK_SIZE;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 32px;&quot;&gt;&lt;span style=&quot;background-color: initial; font-size: 32px;&quot;&gt;end&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=32;strokeWidth=3;dashed=1;fillColor=#FFFFFF;fontColor=#333333;strokeColor=#666666;align=left;spacingLeft=0;spacing=20;" vertex="1" parent="1">
