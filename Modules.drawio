        <mxCell id="5c3OeXmXldCdDjenTQMk-1" value="Tại sườn lên của clk:&lt;br&gt;Nếu i_state_valid = 1 thì o_state = i_state&amp;nbsp;tại clk tiếp theo.&lt;br&gt;Nếu i_valid = 1 thì i_AB sẽ cập nhật o_state, o_AB, o_Y, o_W tại clk tiếp theo,&lt;br&gt;và o_valid = 1 trong 1 clk." style="rounded=0;whiteSpace=wrap;html=1;fontSize=32;strokeWidth=3;dashed=1;fillColor=#FFFFFF;fontColor=#333333;strokeColor=#666666;align=left;spacingLeft=0;spacing=20;" parent="1" vertex="1">
