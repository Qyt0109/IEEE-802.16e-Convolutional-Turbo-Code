        <mxCell id="Y2vVswl0jNHPePmTP5C8-9" value="&lt;div style=&quot;font-size: 32px;&quot;&gt;o_RFFD = 0;&lt;/div&gt;&lt;div style=&quot;font-size: 32px;&quot;&gt;o_we = 1;&lt;/div&gt;&lt;div style=&quot;font-size: 32px;&quot;&gt;next_waddr = (waddr + 1);&lt;/div&gt;&lt;div style=&quot;font-size: 32px;&quot;&gt;if (next_waddr == len_AB) begin&lt;/div&gt;&lt;div style=&quot;font-size: 32px;&quot;&gt;&amp;nbsp; o_LAST = 1;&lt;/div&gt;&lt;div style=&quot;font-size: 32px;&quot;&gt;&amp;nbsp; next_waddr = 0;&lt;/div&gt;&lt;div style=&quot;font-size: 32px;&quot;&gt;&amp;nbsp; next_done_lock = 1;&lt;/div&gt;&lt;div style=&quot;font-size: 32px;&quot;&gt;end&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=32;strokeWidth=3;dashed=1;fillColor=#FFFFFF;fontColor=#333333;strokeColor=#666666;align=left;spacingLeft=0;spacing=20;" parent="1" vertex="1">
